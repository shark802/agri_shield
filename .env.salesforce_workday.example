# -----------------------------
# Salesforce credentials
# -----------------------------
# For production, prefer storing these in a secrets manager and injecting
# environment variables at runtime rather than committing plain credentials.
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_CLIENT_ID=your_connected_app_client_id
SALESFORCE_CLIENT_SECRET=your_connected_app_client_secret
SALESFORCE_USERNAME=your.salesforce.user@example.com
SALESFORCE_PASSWORD=your_salesforce_password
SALESFORCE_SECURITY_TOKEN=your_salesforce_security_token
SALESFORCE_API_VERSION=v61.0

# Owner ID of the user whose handled Cases should become Workday time entries
SALESFORCE_OWNER_ID=005XXXXXXXXXXXX

# Status values that count as "handled"
SALESFORCE_INCLUDED_STATUSES=Closed,Resolved

# Optional custom field containing effort in decimal hours (e.g., 0.25, 0.50, 1.0)
# If not set, DEFAULT_MINUTES_PER_CASE is used.
SALESFORCE_CASE_HOURS_FIELD=

# Field used to derive Workday date. Common options: ClosedDate or LastModifiedDate
SALESFORCE_CASE_DATE_FIELD=ClosedDate

# -----------------------------
# Workday credentials
# -----------------------------
# OAuth2 token endpoint for your Workday API app / integration system
WORKDAY_TOKEN_URL=https://your-workday-domain/ccx/oauth2/your-tenant/token
WORKDAY_CLIENT_ID=your_workday_client_id
WORKDAY_CLIENT_SECRET=your_workday_client_secret

# Endpoint that creates a time entry (usually a custom integration endpoint)
WORKDAY_TIME_ENTRY_ENDPOINT=https://your-workday-domain/ccx/api/custom/time-entry
WORKDAY_WORKER_ID=your_workday_worker_id
WORKDAY_TIME_TYPE_CODE=REG
WORKDAY_PROJECT_CODE=
WORKDAY_TASK_CODE=

# Optional additional headers as JSON object (example includes tenant header)
WORKDAY_CUSTOM_HEADERS_JSON={"X-Tenant":"your-tenant"}

# -----------------------------
# Sync behavior
# -----------------------------
DEFAULT_MINUTES_PER_CASE=15
MAX_STATE_KEYS=10000
REQUEST_TIMEOUT_SECONDS=30
SYNC_STATE_FILE=.salesforce_workday_sync_state.json
