# Salesforce export column mapping
SF_COL_CASE_ID=Case ID
SF_COL_CASE_NUMBER=Case Number
SF_COL_OWNER=Case Owner
SF_COL_STATUS=Status
SF_COL_DATE=Closed Date
SF_COL_SUBJECT=Subject
SF_COL_HOURS=
SF_COL_LAST_MODIFIED=Last Modified Date

# Which rows should be treated as work you handled?
# Leave empty to include all owners in the file.
SF_WORKED_BY_VALUES=Your Name,Your.Email@company.com
SF_INCLUDED_STATUSES=Closed,Resolved

# Optional date window filter (YYYY-MM-DD)
SF_DATE_FROM=
SF_DATE_TO=

# Workday output constants
WORKDAY_IMPORT_WORKER_ID=your_worker_id
WORKDAY_IMPORT_TIME_TYPE_CODE=REG
WORKDAY_IMPORT_PROJECT_CODE=
WORKDAY_IMPORT_TASK_CODE=
WORKDAY_IMPORT_COMMENT_TEMPLATE=Salesforce Case {case_number}: {subject}
EXTERNAL_REFERENCE_PREFIX=salesforce-case

# Behavior
DEFAULT_MINUTES_PER_CASE=15
DEDUPE_ON_CASE_ID_AND_DATE=true
MAX_STATE_KEYS=10000
